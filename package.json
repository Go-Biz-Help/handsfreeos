{
  "name": "handsfreeos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:local": "node scripts/supabase-env.mjs",
    "supabase": "node scripts/supabase.mjs",
    "supabase:start": "node scripts/supabase.mjs start",
    "supabase:stop": "node scripts/supabase.mjs stop",
    "supabase:status": "node scripts/supabase.mjs status",
    "db:seed": "pnpm --filter @hfos/worker seed",
    "db:seed:demo": "pnpm --filter @hfos/worker seed:demo",
    "db:reset": "node scripts/supabase.mjs db reset && pnpm db:seed",
    "sync:start": "bash apps/sync/scripts/start.sh",
    "sync:stop": "bash apps/sync/scripts/stop.sh",
    "openapi": "pnpm --filter @hfos/api openapi:export && pnpm --filter @hfos/api-client generate",
    "addon:new": "node scripts/addon-new.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@12.3.4"
}
