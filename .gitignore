.agents/
.claude/skills/

# env
.env
.env.*
!.env.example

# build output
.next/
dist/
.turbo/
coverage/
# the browser extension the web app hands out, zipped by its build (apps/extension/scripts/download.mjs)
apps/web/public/downloads/hfos-social.zip
playwright-report/
test-results/

# store credentials this machine holds: the Play service-account key eas.json points at, and anything beside it
/secrets/

# local supabase
supabase/.branches/
supabase/.temp/
supabase/signing_keys.json

# assembled design canvases (sources live in design/**/*.dc.html)
design/**/preview/

# os
.DS_Store

# design/impeccable hook cache
.impeccable/

# per-machine Claude Code settings
.claude/settings.local.json

# TypeScript incremental build state
*.tsbuildinfo

# IDE folders (Android Studio)
.idea/
