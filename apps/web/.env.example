# apps/web — publishable values only. Never put a secret key here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# The worker: number search, browser calls and mailbox sign-in.
NEXT_PUBLIC_WORKER_URL=http://localhost:4100
# `pnpm env:local` writes these into .env.local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_PASSKEYS_ENABLED=true
# Connect Gmail stays off until Google finishes its security review of HandsFreeOS.
# NEXT_PUBLIC_GMAIL_ENABLED=false
# The "I run an agency" switch on Set up your business stays hidden unless this is true. `pnpm env:local` turns it on.
# NEXT_PUBLIC_AGENCY_SIGNUP_ENABLED=false
# The booking page's bot check: Cloudflare Turnstile's site key for this domain (the secret goes on the worker
# as TURNSTILE_SECRET_KEY). Unset: no widget. Cloudflare's always-pass test site key is 1x00000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# M18 service areas by distance or drawn on a map. A Google Maps browser key restricted to this app's domains
# (Maps JavaScript API, Geocoding API and Places API (New) for address suggestions). Without it only ZIP-code
# areas are offered.
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# A map ID (Google Cloud, Map management) whose map style has the Postal code feature layer on: shades a ZIP
# code area's ZIP codes on a map and lets people click them on or off. The maps use the style's light or dark
# mode to match the app. Without it ZIP codes are only typed.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
