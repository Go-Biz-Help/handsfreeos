# apps/web — publishable values only. Never put a secret key here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# The worker: number search, browser calls and mailbox sign-in.
NEXT_PUBLIC_WORKER_URL=http://localhost:4100
# `pnpm env:local` writes these into .env.local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_PASSKEYS_ENABLED=true
# Connect Gmail stays off until Google finishes its security review of HandsFreeOS.
# NEXT_PUBLIC_GMAIL_ENABLED=false
