# apps/site — server-side only. Nothing here is NEXT_PUBLIC_, so none of it can reach a browser.
# Locally: copy to .env.local. On Vercel: the site project's Environment Variables.

# Opinly's secret key (sk-…), from opinly.ai → Settings → Developers. It reads the blog's posts, and it can
# also record analytics events and purchases, so it stays on the server. Without it the blog pages show their
# "unavailable" state and everything else on the site still works.
OPINLY_API_KEY=

# The signing secret of the webhook endpoint registered in Opinly (whsec_…), for /api/opinly-webhook.
OPINLY_WEBHOOK_SIGNING_SECRET=

# Only for pointing the blog at a local mock of Opinly's API. Leave unset everywhere real.
# OPINLY_API_URL=http://localhost:4010
