# apps/worker — the only app process allowed to hold the Supabase secret key and provider secrets.
# `pnpm env:local` writes apps/worker/.env with local values (the fake carrier and a generated key).
LOG_LEVEL=info
WORKER_POLL_MS=1000
# DATABASE_URL_WORKER=postgresql://hfos_worker:...@127.0.0.1:54422/postgres
# SMTP_URL=smtp://127.0.0.1:54425
# MAIL_FROM=HandsFreeOS <hello@handsfreeos.local>
# WEB_URL=http://localhost:3000
# SUPABASE_URL=http://127.0.0.1:54421
# SUPABASE_SECRET_KEY=<the local secret key>

# The worker's HTTP server: provider webhooks and the number search the web app calls.
# WORKER_HTTP_PORT=4100
# WORKER_PUBLIC_URL=http://127.0.0.1:4100   (production: the https address Twilio calls)
# WEB_ORIGINS=http://localhost:3000

# Seals subaccount tokens before they reach the database: 32 random bytes, base64 (openssl rand -base64 32).
# Rotate by moving the old key into WORKER_ENCRYPTION_KEYS_PREVIOUS (comma-separated).
# WORKER_ENCRYPTION_KEY=<generated>
# WORKER_ENCRYPTION_KEYS_PREVIOUS=

# Carrier: `fake` locally and in tests (refused in production), `twilio` in production.
# TELEPHONY_PROVIDER=fake
# FAKE_APPROVAL_MS=3000
# TWILIO_ACCOUNT_SID=<master account sid>
# TWILIO_AUTH_TOKEN=<master account auth token>
# TWILIO_PRIMARY_PROFILE_SID=<HandsFreeOS's approved ISV customer profile, BU...; local numbers need it>

# Optional: shorten the unanswered-message email for demos (milliseconds); workspaces set minutes otherwise.
# UNANSWERED_ALERT_MS=
# REGISTRATION_POLL_MS=900000
# How often a number on its way here from another Twilio account or GoHighLevel is looked for.
# NUMBER_IMPORT_POLL_MS=300000

# Workspace email: `smtp` locally and in tests (Mailpit; domains verify themselves), `postmark` in production.
# EMAIL_TRANSPORT=smtp
# MAIL_DOMAIN=mail.handsfreeos.com
# POSTMARK_SERVER_TOKEN=<server API token>
# POSTMARK_ACCOUNT_TOKEN=<account API token; adds businesses' own domains>
# POSTMARK_MESSAGE_STREAM=outbound
# The Broadcasts stream campaign email goes on. Unset: email campaigns pause instead of sending.
# POSTMARK_BROADCAST_STREAM=broadcast
# Postmark signs nothing: its webhook URLs carry this basic auth (a long random value in production).
# POSTMARK_WEBHOOK_USER=postmark
# POSTMARK_WEBHOOK_PASSWORD=

# Connected mailboxes (Outlook and Gmail). Leave these unset locally: mailboxes then live in memory, and
# Connect Outlook opens a stand-in sign-in page on the worker. Production refuses the stand-in.
# MAILBOX_PROVIDER=fake
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# How often each mailbox is checked (milliseconds) and how far back a new one looks (days).
# MAILBOX_SYNC_MS=3000
# MAILBOX_BACKFILL_DAYS=30

# Calendar connections (each person's own Google or Outlook calendar). Leave these unset locally: calendars then
# live in memory, and Connect opens the same stand-in sign-in page. Google Calendar has its own Google Cloud
# project (redirect https://hooks.handsfreeos.com/oauth/google/callback); Outlook reuses the Microsoft values
# above, with Calendars.ReadWrite added. Production refuses the stand-in.
# CALENDAR_PROVIDER=fake
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Zoom (Settings → My calendar → Video meetings): a Zoom Marketplace OAuth app. Leave unset locally for the stand-in.
# ZOOM_OAUTH_CLIENT_ID=
# ZOOM_OAUTH_CLIENT_SECRET=
# How often each connected calendar's busy times are read (milliseconds).
# CALENDAR_REFRESH_MS=600000

# The public booking page's bot check: Cloudflare Turnstile's secret key (the site key goes on the web as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY). Unset: no check, which production refuses unless ALLOW_NO_BOT_CHECK=1.
# Cloudflare's always-pass test keys are site 1x00000000000000000000AA and secret
# 1x0000000000000000000000000000000AA (production refuses the test secret).
# TURNSTILE_SECRET_KEY=

# The Assistant: Claude through Anthropic's API. Without a key its panel says it isn't set up.
# Use a separate local key from the Claude Console (never the production one) and never commit it.
# `pnpm env:local` keeps these lines when it rewrites apps/worker/.env.
# The browser tests use a scripted stand-in and never call Anthropic.
# ANTHROPIC_API_KEY=<your local key, sk-ant-api...>
# Ask HandsFreeOS, the team's own helper:
# ASSISTANT_MODEL=claude-opus-5-5
# Everything else: the AI teammate, calls, workflow AI steps, the builders and the knowledge base:
# AI_MODEL=claude-sonnet-5
# Ask HandsFreeOS finds most of its tools by searching (on), or gets every tool every time (off):
# ASSISTANT_TOOL_SEARCH=on
# Tokens one workspace may use per day, cache reads and writes included (digits only, no commas).
# ASSISTANT_DAILY_TOKENS=2000000

# The backup AI: OpenAI answers every AI feature while Claude is down, and Claude takes over again once it's
# well. Unset: no backup, Claude alone as before. It stands behind ANTHROPIC_API_KEY, never in its place.
# Use a separate local key from OpenAI's dashboard (never the production one) and never commit it.
# `pnpm env:local` keeps these lines when it rewrites apps/worker/.env.
# OPENAI_API_KEY=<your local key, sk-proj-...>
# The backups for AI_MODEL, ASSISTANT_MODEL and calls:
# OPENAI_MODEL=gpt-6-sol
# OPENAI_ASSISTANT_MODEL=gpt-6-sol
# OPENAI_VOICE_MODEL=gpt-6-luna
# Who is emailed when it switches to OpenAI and back (comma-separated; unset: PLATFORM_OWNER_EMAILS).
# AI_ALERT_EMAILS=

# Turning a call recording into words. Without a key the stand-in transcriber answers, which is what the
# tests use: the same path as production, with made-up words. `pnpm env:local` keeps these two lines.
# TRANSCRIBER=deepgram
# DEEPGRAM_API_KEY=<your local key from the Deepgram console>

# M18 service areas by distance or drawn on a map: the worker looks up where a customer's address is with
# Google's Geocoding API. Without a key in production only ZIP-code areas work. Locally the stand-in is used.
# GOOGLE_MAPS_SERVER_KEY=<a server key restricted to the Geocoding API>
# GEOCODER=google

# M18 step 5: the AI teammate answering calls live. The same Deepgram key listens and speaks (Nova-3 and
# Aura 2); without it in production calls ring the team and go to voicemail, as before. It also powers talking
# out loud on the web and the phone (the Assistant's mic, and Talk out loud on a test call). Locally the
# stand-in is used: it hears any recording as "Hello, can you hear me?" and answers with quiet audio.
# VOICE_MODEL picks a faster model for calls (unset: AI_MODEL).
# VOICE_AGENT=deepgram
# VOICE_MODEL=<a Claude model id>

# How far the usage wallet (M16) has been rolled out. `off` records nothing at all, which is the default and
# what you want locally. `shadow` prices and records every text, call and AI request and never warns or stops
# anything — that is the week that proves the rate card before a customer is charged. `on` is the real thing.
# WALLET_MODE=off

# Local sites a website scan may read over plain http, for Playwright (development only; refused in
# production, honoured only with TELEPHONY_PROVIDER=fake). Start the stand-in site with
# `pnpm --filter @hfos/worker knowledge-site`.
# FETCH_TEST_ORIGINS=http://127.0.0.1:4190

# Opinly analytics: sign-ups and paid founding seats, sent server-side so a sale is credited to the blog post
# or campaign that brought the person to handsfreeos.com (src/opinly.ts). Unset: nothing is queued. Must be
# the secret sk- key (the same one the website reads its blog with), never the website's pk- key.
# OPINLY_API_KEY=

# What add-ons connect to (Real Estate round five): `real` services, or stand-ins that accept any key but one with
# "wrong" in it (the default outside production; production refuses it).
# ADDON_CONNECTORS=fake

# HandsFreeOS's own accounts at the services add-ons connect to, by <add-on>.<service>, each an object of the
# fields that service asks for. Staff turn one on for a business; a business's own account is used before it.
# Never in the API's environment (it refuses to start). Example:
# ADDON_PLATFORM_KEYS={"realestate.repliers":{"apiKey":"…"}}
